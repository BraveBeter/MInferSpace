# 独立源码仓库；保留 worktrees/README.md
/worktrees/*/

# 实际虚拟环境、缓存和临时文件；保留环境定义及快照
/envs/runtime/
/.venv*/
# 保留临时目录的使用说明
/tmp/*
!/tmp/README.md
__pycache__/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.cache/

# 模型权重及二进制产物；配置、来源和准备脚本仍可跟踪
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.onnx
*.gguf

# 下载的模型及数据压缩包
/checkpoints/**/*.zip
/checkpoints/**/*.tar*
/checkpoints/**/*.tgz
/datasets/**/*.zip
/datasets/**/*.tar*
/datasets/**/*.tgz

# Profiler 原生产物；保留 traces 内的说明和归档元数据
/profile-results/**/traces/**
!/profile-results/**/traces/**/
!/profile-results/**/traces/**/*.md
!/profile-results/**/traces/**/artifacts.yaml
!/profile-results/**/traces/**/manifest.json
/profile-results/**/*.nsys-rep
/profile-results/**/*.ncu-rep
/profile-results/**/*.qdrep
/profile-results/**/*.qdstrm
/profile-results/**/*.pt.trace.json
/profile-results/**/*.pt.trace.json.gz

# 明确位置的运行日志；不全局忽略日志及分析材料
/benchmark-results/**/execution/*.log
/benchmark-results/**/logs/*.log
/profile-results/**/execution/*.log
/profile-results/**/logs/*.log
